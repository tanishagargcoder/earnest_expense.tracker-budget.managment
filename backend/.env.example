# Server
NODE_ENV=development
PORT=4000

# Comma-separated list of origins allowed to call the API (the React app)
CORS_ORIGINS=http://localhost:5173

# PostgreSQL connection string
DATABASE_URL=postgres://expense:expense@localhost:5432/expense_tracker
# Set to true when your provider requires SSL (Render, Neon, Supabase, ...)
DATABASE_SSL=false

# JWT - use long random strings in production (e.g. `openssl rand -hex 64`)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# Refresh-token cookie. Use `none` + COOKIE_SECURE=true when the frontend
# and API live on different domains (e.g. Vercel + Render).
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

BCRYPT_ROUNDS=12
